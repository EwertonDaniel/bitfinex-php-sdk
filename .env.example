# Credentials issued at https://setting.bitfinex.com/api.
# Only needed for authenticated endpoints; the public ones work without them.
#
# NOTE: the SDK reads $_ENV / $_SERVER / getenv(). It does not parse this file
# itself. Laravel loads it for you; standalone, load it yourself (vlucas/phpdotenv)
# or export the variables into the environment.
BITFINEX_API_KEY=
BITFINEX_API_SECRET=

# Base URLs. Leave unset to use the values shipped with the package.
# Point BITFINEX_PRIVATE_URL at a local capture server to inspect what the SDK
# actually sends, instead of reaching the exchange.
BITFINEX_PUBLIC_URL=https://api-pub.bitfinex.com
BITFINEX_PRIVATE_URL=https://api.bitfinex.com

# Request timeouts, in seconds.
BITFINEX_PUBLIC_TIMEOUT=10
BITFINEX_AUTHENTICATED_TIMEOUT=30

# Session token issued by v2/auth/w/token.
BITFINEX_TOKEN_SCOPE=api
BITFINEX_TOKEN_TTL=120
BITFINEX_TOKEN_WRITE_PERMISSION=false
